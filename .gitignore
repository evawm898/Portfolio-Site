node_modules/
# package-lock.json IS committed (Oct 1): it pins @netlify/blobs and its tree so a
# Netlify build resolves the same dependencies every time. Local dev deps are
# installed with `npm i --no-save`, which never writes the lockfile.

# Skirt panelizer (Python tooling) — scratch outputs stay out of git;
# the final SVG/report in skirt/ ARE committed (the page depends on them).
__pycache__/
*.pyc
tools/skirt-panelizer/out/
tools/dress-shell/out/

# tools/audit-hires.mjs output (screenshots + results.json) — regenerate, don't commit.
audit-out/

# package.json is committed so Netlify installs the Function's @netlify/blobs
# dependency at deploy time. Local dev deps (three, playwright-core, and for
# tools/verify-cards-fonts.mjs: jspdf@2.5.1, jszip, google-font-metadata) live
# in the gitignored node_modules and are NOT listed here — the browser loads
# three, jsPDF and JSZip from the CDN, and the verify/shot tools use whatever
# is already in node_modules.

# tools/verify-cards-fonts.mjs replays real Google Fonts responses from here so
# a second run needs no network. Regenerable, so not committed.
tools/.cache/

# tools/.scratch — throwaway harnesses and gate logs from a working session.
# Regenerate, never commit.
tools/.scratch/

# tools/verify-scene.mjs writes a mutated copy of scene/ beside the original,
# because those modules import each other by relative path. Swept at start and
# in a finally; ignored here so a crashed run cannot dirty the tree.
scene/__mutant__*/

# tools/bug-wing-library-fit.mjs reads Eva's reference sheets (stock art, one
# watermarked) from here. They are never committed; only the fitted outline
# data (bug-wing-library.js) is.
tools/bug-wing-sources/

# tools/verify-tile.mjs --negative-control writes mutated copies of the tile modules
# into .tile-mutant-<pid>-<k>/ at the repo root (they import ../bug-geometry.js) and
# removes them in a finally; ignored so a crashed run cannot dirty the tree.
.tile-mutant-*/
